# Copy to .env and fill in to enable Trakt (Settings → Tracking).
# Create an app at https://trakt.tv/oauth/applications
# with redirect URI: urn:ietf:wg:oauth:2.0:oob
EXPO_PUBLIC_TRAKT_CLIENT_ID=
EXPO_PUBLIC_TRAKT_CLIENT_SECRET=

# Clerk sign-in (optional, phones only). Publishable key from dashboard.clerk.com → API keys.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
