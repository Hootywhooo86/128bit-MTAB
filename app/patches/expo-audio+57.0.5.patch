@@ -0,0 +1,98 @@
+package expo.modules.audio
+
+import android.content.Context
+import androidx.media3.common.C
+import androidx.media3.common.util.UnstableApi
+import androidx.media3.exoplayer.DefaultRenderersFactory
+import androidx.media3.exoplayer.audio.AudioSink
+import androidx.media3.exoplayer.audio.DefaultAudioSink
+import androidx.media3.exoplayer.audio.TeeAudioProcessor
+import java.nio.ByteBuffer
+import java.nio.ByteOrder
+import kotlin.math.PI
+import kotlin.math.cos
+import kotlin.math.ln
+import kotlin.math.max
+import kotlin.math.min
+import kotlin.math.sqrt
+
+/**
+ * 128bitPlay: loudness of 16 frequency bands of what's playing, ~12 times a second, read
+ * from the decoded audio itself (no microphone permission, unlike Android's Visualizer).
+ */
+@UnstableApi
+class LevelTap : TeeAudioProcessor.AudioBufferSink {
+  @Volatile var listener: ((List<Float>) -> Unit)? = null
+
+  private var rate = 44_100
+  private var channels = 2
+  private var encoding = C.ENCODING_INVALID
+  private val window = FloatArray(1024)
+  private var filled = 0
+  private var lastEmit = 0L
+  private val peaks = FloatArray(BANDS) { 1e-3f }
+
+  fun renderersFactory(context: Context) = object : DefaultRenderersFactory(context) {
+    override fun buildAudioSink(context: Context, enableFloatOutput: Boolean, enableAudioTrackPlaybackParams: Boolean): AudioSink =
+      DefaultAudioSink.Builder(context)
+        .setAudioProcessors(arrayOf(TeeAudioProcessor(this@LevelTap)))
+        .setEnableFloatOutput(enableFloatOutput)
+        .setEnableAudioTrackPlaybackParams(enableAudioTrackPlaybackParams)
+        .build()
+  }
+
+  override fun flush(sampleRateHz: Int, channelCount: Int, encoding: Int) {
+    rate = sampleRateHz
+    channels = max(1, channelCount)
+    this.encoding = encoding
+    filled = 0
+  }
+
+  override fun handleBuffer(buffer: ByteBuffer) {
+    if (listener == null) return
+    val b = buffer.duplicate().order(ByteOrder.nativeOrder())
+    val float = encoding == C.ENCODING_PCM_FLOAT
+    if (!float && encoding != C.ENCODING_PCM_16BIT) return
+    val frameBytes = channels * (if (float) 4 else 2)
+    while (b.remaining() >= frameBytes) {
+      var s = 0f
+      repeat(channels) { s += if (float) b.float else b.short / 32768f }
+      window[filled++] = s / channels
+      if (filled == window.size) {
+        filled = 0
+        val now = System.nanoTime()
+        if (now - lastEmit >= 80_000_000L) {
+          lastEmit = now
+          listener?.invoke(analyze())
+        }
+      }
+    }
+  }
+
+  /** Goertzel at 16 log-spaced frequencies (90 Hz – 7 kHz), each scaled to its recent peak. */
+  private fun analyze(): List<Float> {
+    val n = window.size
+    return List(BANDS) { i ->
+      val f = 90.0 * Math.pow(7000.0 / 90.0, i / (BANDS - 1.0))
+      val coeff = 2 * cos(2 * PI * min(f, rate / 2.2) / rate)
+      var s1 = 0.0
+      var s2 = 0.0
+      for (k in 0 until n) {
+        // Hann window keeps neighbouring bands apart.
+        val w = 0.5 - 0.5 * cos(2 * PI * k / (n - 1))
+        val s0 = window[k] * w + coeff * s1 - s2
+        s2 = s1
+        s1 = s0
+      }
+      val mag = sqrt(max(0.0, s1 * s1 + s2 * s2 - coeff * s1 * s2)).toFloat()
+      // Auto-gain: each band remembers its loudest moment and slowly forgets it.
+      peaks[i] = max(mag, peaks[i] * 0.995f)
+      val level = ln(1 + 9 * mag / peaks[i]) / ln(10f)
+      level.coerceIn(0f, 1f)
+    }
+  }
+
+  companion object {
+    const val BANDS = 16
+  }
+}
